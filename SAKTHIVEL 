
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Sakthivel | Portfolio</title>

<style>
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
    scroll-behavior: smooth;
}

body {
    background: #080808;
    color: white;
    font-family: Arial, sans-serif;
    line-height: 1.6;
}

/* NAVIGATION */

nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px 8%;
    background: #111;
    position: sticky;
    top: 0;
    z-index: 100;
}

.logo {
    font-size: 24px;
    font-weight: bold;
    color: #00d9ff;
}

nav a {
    color: white;
    text-decoration: none;
    margin-left: 18px;
}

nav a:hover {
    color: #00d9ff;
}

/* HOME */

#home {
    min-height: 85vh;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 60px 8%;
    text-align: center;
}

.hero h1 {
    font-size: 50px;
    margin: 15px 0;
}

.hero h1 span {
    color: #00d9ff;
}

.hero p {
    color: #aaa;
    font-size: 18px;
}

.btn {
    display: inline-block;
    margin-top: 25px;
    padding: 12px 25px;
    background: #00d9ff;
    color: black;
    text-decoration: none;
    border-radius: 6px;
    font-weight: bold;
}

/* COMMON SECTIONS */

section {
    padding: 75px 8%;
}

h2 {
    text-align: center;
    font-size: 32px;
    margin-bottom: 30px;
    color: #00d9ff;
}

.about-text {
    max-width: 750px;
    margin: auto;
    text-align: center;
    color: #ccc;
}

/* SKILLS */

.skills-container,
.projects-container {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
}

.card {
    background: #171717;
    border: 1px solid #333;
    padding: 25px;
    border-radius: 12px;
    text-align: center;
    transition: 0.3s;
}

.card:hover {
    transform: translateY(-7px);
    border-color: #00d9ff;
}

.card h3 {
    margin-bottom: 12px;
    color: #00d9ff;
}

.card p {
    color: #bbb;
}

/* EDUCATION */

.education {
    max-width: 650px;
    margin: auto;
    text-align: center;
    background: #171717;
    padding: 30px;
    border-radius: 12px;
}

/* CONTACT */

.contact {
    text-align: center;
    background: #171717;
    padding: 35px;
    border-radius: 12px;
}

.contact p {
    margin: 12px;
    color: #ccc;
}

.contact a {
    color: #00d9ff;
    text-decoration: none;
}

/* FOOTER */

footer {
    background: #111;
    text-align: center;
    padding: 20px;
    color: #888;
}

/* MOBILE RESPONSIVE */

@media(max-width: 700px) {
    nav {
        flex-direction: column;
        gap: 15px;
    }

    nav a {
        margin: 0 6px;
        font-size: 13px;
    }

    .hero h1 {
        font-size: 36px;
    }

    .skills-container,
    .projects-container {
        grid-template-columns: 1fr;
    }
}
</style>
</head>

